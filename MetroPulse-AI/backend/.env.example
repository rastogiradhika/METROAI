# MetroPulse AI Backend Configuration
# Copy this file to .env and configure for your local environment

APP_NAME="MetroPulse AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api"

HOST="0.0.0.0"
PORT=8000

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","*"]

# Supabase Credentials (optional for local/demo mode)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key-here"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Video Upload Constraints
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
MAX_PROCESSING_FRAMES=300
FRAME_SAMPLE_RATE=5

# ML Inference Configuration
ML_DEVICE="cpu"

# Crowd Freshness & Alerts
CROWD_FRESHNESS_SECONDS=300
CROWD_EXPIRY_SECONDS=900
REPORT_RATE_LIMIT_SECONDS=60
ALERT_COOLDOWN_SECONDS=300
